                                  "id": "artifacts-view-body",
                                  "type": "block",
                                  "content": {
                                    "mod": "help"
                                  }
                                }
                              ],
                              "background": "background",
                              "border": {
                                "width": 1,
                                "color": "border"
                              },
                              "radius": 10,
                              "resizable": false
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
